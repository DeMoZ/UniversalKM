+/**@brief UniversalKM: advertise as a BLE HID keyboard (HID + Battery UUIDs, keyboard appearance,
+ *        name in the scan response) or with the stock data. Works while advertising.
+ */
+void ble_advertising_hid_mode_set(bool hid) {
+    static ble_uuid_t hid_uuids[] = {
+        {BLE_UUID_HUMAN_INTERFACE_DEVICE_SERVICE, BLE_UUID_TYPE_BLE},
+        {BLE_UUID_BATTERY_SERVICE, BLE_UUID_TYPE_BLE},
+    };
+    ble_advdata_t advdata;
+    ble_advdata_t srdata;
+    memset(&advdata, 0, sizeof(advdata));
+    memset(&srdata, 0, sizeof(srdata));
+    advdata.flags = BLE_GAP_ADV_FLAGS_LE_ONLY_GENERAL_DISC_MODE;
+    if (hid) {
+        // Everything in the advertising packet itself (29 of 31 bytes): phones that scan passively
+        // never ask for the scan response and would list the keyboard without a name.
+        advdata.name_type = BLE_ADVDATA_FULL_NAME;
+        advdata.include_appearance = true;
+        advdata.uuids_complete.uuid_cnt = ARRAY_SIZE(hid_uuids);
+        advdata.uuids_complete.p_uuids = hid_uuids;
+        srdata.uuids_complete.uuid_cnt = ARRAY_SIZE(hid_uuids);
+        srdata.uuids_complete.p_uuids = hid_uuids;
+    } else {
+        advdata.name_type = BLE_ADVDATA_FULL_NAME;
+        srdata.uuids_complete.uuid_cnt = ARRAY_SIZE(m_adv_uuids);
+        srdata.uuids_complete.p_uuids = m_adv_uuids;
+    }
+    APP_ERROR_CHECK(sd_ble_gap_appearance_set(hid ? BLE_APPEARANCE_HID_KEYBOARD : BLE_APPEARANCE_UNKNOWN));
+    // The module stores the new data before handing it to the SoftDevice. While advertising is stopped
+    // the SoftDevice may refuse a data-only update; the next ble_advertising_start() applies the data.
+    ret_code_t err_code = ble_advertising_advdata_update(&m_advertising, &advdata, &srdata);
+    if (err_code != NRF_SUCCESS) {
+        NRF_LOG_INFO("Advertising data stored for the next start (%d)", err_code);
+    }
+}
